
#include <iostream>
using namespace std;

int main() {
    int n, i;
    float grade, total = 0, cgpa;

    cout << "Enter number of subjects: ";
    cin >> n;

    for (i = 1; i <= n; i++) {
        cout << "Enter grade point of subject " << i << ": ";
        cin >> grade;
        total = total + grade;
    }

    cgpa = total / n;

    cout << "Total Grade Points = " << total << endl;
    cout << "CGPA = " << cgpa << endl;

    return 0;
}
