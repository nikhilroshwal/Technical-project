
#include <iostream>
using namespace std;

int main() {
    int a[5], b[5], i, choice, sum = 0;
    int large, small;

    cout << "Enter 5 elements of first array:\n";
    for (i = 0; i < 5; i++)
        cin >> a[i];

    cout << "Enter 5 elements of second array:\n";
    for (i = 0; i < 5; i++)
        cin >> b[i];

    cout << "\n1. Addition of two arrays";
    cout << "\n2. Subtraction of two arrays";
    cout << "\n3. Multiplication of array elements";
    cout << "\n4. Find largest and smallest element";
    cout << "\n5. Calculate average";
    cout << "\nEnter your choice: ";
    cin >> choice;

    switch (choice) {
        case 1:
            for (i = 0; i < 5; i++)
                cout << a[i] + b[i] << " ";
            break;

        case 2:
            for (i = 0; i < 5; i++)
                cout << a[i] - b[i] << " ";
            break;

        case 3:
            for (i = 0; i < 5; i++)
                cout << a[i] * b[i] << " ";
            break;

        case 4:
            large = small = a[0];
            for (i = 1; i < 5; i++) {
                if (a[i] > large) large = a[i];
                if (a[i] < small) small = a[i];
            }
            cout << "Largest = " << large;
            cout << "\nSmallest = " << small;
            break;

        case 5:
            for (i = 0; i < 5; i++)
                sum += a[i];
            cout << "Average = " << sum / 5.0;
            break;

        default:
            cout << "Invalid choice!";
    }

    return 0;
}
