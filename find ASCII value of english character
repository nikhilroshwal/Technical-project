
#include <iostream>
using namespace std;

int main() {
    char ch;

    cout << "Lowercase Characters and ASCII Values:\n";
    for (ch = 'a'; ch <= 'z'; ch++)
        cout << ch << " = " << int(ch) << endl;

    cout << "\nUppercase Characters and ASCII Values:\n";
    for (ch = 'A'; ch <= 'Z'; ch++)
        cout << ch << " = " << int(ch) << endl;

    return 0;
}
